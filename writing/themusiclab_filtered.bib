  JOURNAL = {Psychology of Music},
  MONTH = {},
  NUMBER = {4},
  PAGES = {599--623},
  PUBLISHER = {SAGE Publications Ltd},
  TITLE = {What Makes Music Emotionally Significant? {{Exploring}} the Underlying Mechanisms},
  VOLUME = {42},
